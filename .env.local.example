# Copy this file to .env.local and fill in real values. .env.local.example
# is a template (no secrets) and IS committed; .env.local itself is
# gitignored (see ".gitignore" -- ".env*" is already excluded).

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project settings -> API -> service_role (SECRET -- server only,
# never prefix with NEXT_PUBLIC_, never import outside lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (test mode keys to start -- Phase 7)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (test mode keys to start -- Phase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
